<Window x:Class="Курсовая_ооп.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NEXUS INDUSTRIAL AUDIO WORKSTATION v4.0" Height="780" Width="1220"
        Background="#08080C" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI">
    
    <Window.Resources>
        <Style TargetType="Button" x:Key="NeonButton">
            <Setter Property="Background" Value="#14141E"/>
            <Setter Property="Foreground" Value="#D0D0D5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#252535"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="12,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1E1E2F"/>
                    <Setter Property="BorderBrush" Value="#00FFAA"/>
                    <Setter Property="Foreground" Value="#00FFAA"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#0A0A0F"/>
                    <Setter Property="Foreground" Value="#404050"/>
                    <Setter Property="BorderBrush" Value="#101015"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="PurpleButton" BasedOn="{StaticResource NeonButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#9D4EDD"/>
                    <Setter Property="Foreground" Value="#C77DFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="RecButton" BasedOn="{StaticResource NeonButton}">
            <Setter Property="Background" Value="#2D141A"/>
            <Setter Property="BorderBrush" Value="#501A24"/>
            <Setter Property="Foreground" Value="#FF4A7A"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#451823"/>
                    <Setter Property="BorderBrush" Value="#FF2A5F"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#0F0F15" BorderBrush="#1A1A26" BorderThickness="0,0,1,0" Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="✦ NEXUS STATION" Foreground="#00FFAA" FontSize="20" FontWeight="Black" Margin="0,5,0,25"/>
                    
                    <Grid Margin="0,0,0,25">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="btnNavStudio" Grid.Column="0" Content="СТУДИЯ" Style="{StaticResource NeonButton}" Foreground="#00FFAA" BorderBrush="#00FFAA" Margin="0,0,5,0" Click="BtnNavStudio_Click"/>
                        <Button x:Name="btnNavArchive" Grid.Column="1" Content="АРХИВ / БД" Style="{StaticResource NeonButton}" Margin="5,0,0,0" Click="BtnNavArchive_Click"/>
                    </Grid>
                    
                    <TextBlock Text="МАРШРУТИЗАЦИЯ ЖЕЛЕЗА" Foreground="#555566" FontSize="11" FontWeight="Bold" Margin="0,0,0,15"/>
                    
                    <TextBlock Text="Исполнитель (Vocal)" Foreground="#A0A0B0" FontSize="12" Margin="0,0,5,0"/>
                    <ComboBox x:Name="cbArtists" Background="#14141E" Foreground="Black" Margin="0,0,0,15" Padding="6"/>

                    <TextBlock Text="Инженер за пультом" Foreground="#A0A0B0" FontSize="12" Margin="0,0,0,5"/>
                    <ComboBox x:Name="cbEngineers" Background="#14141E" Foreground="Black" Margin="0,0,0,15" Padding="6"/>

                    <TextBlock Text="Имя мастер-файла" Foreground="#00FFAA" FontSize="12" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtTrackTitle" Background="#14141E" Foreground="White" BorderThickness="1" BorderBrush="#252535" Padding="8" Margin="0,0,0,15" Text="Session_Track"/>

                    <Button x:Name="btnLoadBeat" Content="+ ВЫБРАТЬ МИНУСОВКУ (БИТ)" Style="{StaticResource PurpleButton}" Click="BtnLoadBeat_Click" Margin="0,0,0,5"/>
                    <TextBlock x:Name="lblBeatStatus" Text="Минус: не выбран (Акапелла)" Foreground="#555566" FontSize="11" Margin="0,0,0,25" TextWrapping="Wrap"/>

                    <Button x:Name="btnRoute" Content="ИНИЦИАЛИЗИРОВАТЬ ШИНУ" Style="{StaticResource NeonButton}" Background="#142824" BorderBrush="#00AA77" Height="40" Click="BtnRoute_Click" Margin="0,0,0,25"/>

                    <TextBlock Text="МНОГОКАНАЛЬНЫЙ СВЕДЕНИЕ" Foreground="#555566" FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>
                    <Button x:Name="btnOpenArranger" Content="🎛 МУЛЬТИТРЕК АРАНЖИРОВКА" Style="{StaticResource PurpleButton}" Height="40" Background="#1D122C" Click="BtnOpenArranger_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid x:Name="gridStudio" Grid.Column="1" Margin="25" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#13131F" CornerRadius="8" BorderBrush="#202030" BorderThickness="1" Padding="18" Margin="0,0,0,15">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="МОДУЛЬ СЭМПЛИРОВАНИЯ И ПИТЧ-ШИФТИНГ (TAPE SPEED)" Foreground="#8A2BE2" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="lblActiveTrack" Text="АКТИВНЫЙ ТРЕК: (ШИНА ПУСТА)" Foreground="#00FFAA" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="btnPlay" Grid.Column="0" Content="▶ PLAY / PAUSE" Style="{StaticResource NeonButton}" Width="130" Margin="0,0,8,0" IsEnabled="False" Click="BtnPlay_Click"/>
                        <Button x:Name="btnStopPlay" Grid.Column="1" Content="■ STOP" Style="{StaticResource NeonButton}" Width="70" Margin="0,0,8,0" IsEnabled="False" Click="BtnStopPlay_Click"/>
                        <Button x:Name="btnReverse" Grid.Column="2" Content="REVERSE FX" Style="{StaticResource PurpleButton}" Width="100" Margin="0,0,20,0" IsEnabled="False" Click="BtnReverse_Click"/>
                        
                        <TextBlock Grid.Column="3" Text="ПИТЧ:" Foreground="#757585" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                        <Slider x:Name="slSpeed" Grid.Column="4" Minimum="5" Maximum="20" Value="10" VerticalAlignment="Center" ValueChanged="SlSpeed_ValueChanged"/>
                        <TextBlock x:Name="lblSpeedVal" Grid.Column="5" Text="1.0x" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="slStudioTimeline" Grid.Column="0" Minimum="0" Maximum="100" Value="0" VerticalAlignment="Center" PreviewMouseLeftButtonUp="SlStudioTimeline_Seek" PreviewMouseDown="SlStudioTimeline_MouseDown"/>
                        <TextBlock x:Name="lblStudioTime" Grid.Column="1" Text="00:00 / 00:00" Foreground="#00FFAA" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Background="#13131F" CornerRadius="8" BorderBrush="#202030" BorderThickness="1" Padding="15" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="МНОГОКАНАЛЬНЫЙ СЭМПЛЕРНЫЙ РЭК (ПЭДЫ / БИТМЕЙКИНГ)" Foreground="#3A86FF" FontSize="11" FontWeight="Bold" Margin="0,0,0,12"/>
                    
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="5"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <Border Grid.Column="0" Background="#1A1A26" CornerRadius="6" Padding="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Content="CH1: KICK" Style="{StaticResource NeonButton}" Click="BtnKick_Click" Height="30"/>
                                    <Button x:Name="btnLoadKick" Grid.Column="1" Content="LOAD" Style="{StaticResource PurpleButton}" Margin="5,0" Padding="8,4" FontSize="10" Click="BtnLoadKick_Click"/>
                                    <Slider x:Name="slKickVol" Grid.Column="2" Minimum="0" Maximum="100" Value="80" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2" Background="#1A1A26" CornerRadius="6" Padding="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Content="CH2: SNARE" Style="{StaticResource NeonButton}" Click="BtnSnare_Click" Height="30"/>
                                    <Button x:Name="btnLoadSnare" Grid.Column="1" Content="LOAD" Style="{StaticResource PurpleButton}" Margin="5,0" Padding="8,4" FontSize="10" Click="BtnLoadSnare_Click"/>
                                    <Slider x:Name="slSnareVol" Grid.Column="2" Minimum="0" Maximum="100" Value="80" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <Border Grid.Column="0" Background="#1A1A26" CornerRadius="6" Padding="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="CH3: CLAP" Style="{StaticResource NeonButton}" Click="BtnClap_Click" Height="30"/>
                                    <Button x:Name="btnLoadClap" Grid.Column="1" Content="LOAD" Style="{StaticResource PurpleButton}" Margin="5,0" Padding="8,4" FontSize="10" Click="BtnLoadClap_Click"/>
                                    <Slider x:Name="slClapVol" Grid.Column="2" Minimum="0" Maximum="100" Value="80" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2" Background="#1A1A26" CornerRadius="6" Padding="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="btnCustomPad" Grid.Column="0" Content="CH4: USER" Style="{StaticResource NeonButton}" Click="BtnCustomPad_Click" Height="30" IsEnabled="False"/>
                                    <Button x:Name="btnLoadCustom" Grid.Column="1" Content="LOAD" Style="{StaticResource PurpleButton}" Margin="5,0" Padding="8,4" FontSize="10" Click="BtnLoadCustom_Click"/>
                                    <Slider x:Name="slCustomVol" Grid.Column="2" Minimum="0" Maximum="100" Value="80" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Background="#13131F" CornerRadius="8" BorderBrush="#202030" BorderThickness="1" Padding="15" Margin="0,0,0,15">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="btnRecord" Content="● ЗАПИСАТЬ СЕССИЮ (REC)" Style="{StaticResource RecButton}" Width="220" Height="45" FontSize="14" Margin="0,0,15,0" IsEnabled="False" Click="BtnRecord_Click"/>
                    <Button x:Name="btnStop" Content="■ СТОП ЗАПИСЬ" Style="{StaticResource NeonButton}" Width="160" Height="45" FontSize="14" IsEnabled="False" Click="BtnStop_Click"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Background="#06060A" CornerRadius="8" Padding="15" BorderBrush="#1F1F2E" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="CONSOLE MATRIX REALTIME LOG" Foreground="#444455" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
                    <ListBox x:Name="lbLog" Grid.Row="1" Background="Transparent" Foreground="#00FFAA" BorderThickness="0" FontFamily="Consolas" FontSize="12"/>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="gridArchive" Grid.Column="1" Margin="25" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#13131F" CornerRadius="8" Padding="15" BorderBrush="#202030" BorderThickness="1" Margin="0,0,0,15">
                <Grid>
                    <TextBlock Text="БАЗА ДАННЫХ ПЕРСОНАЛА И КАДРОВ СТУДИИ" Foreground="White" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button Content="⚙️ ОТКРЫТЬ МЕНЕДЖЕР СПЕЦИАЛИСТОВ И ИСПОЛНИТЕЛЕЙ" Style="{StaticResource PurpleButton}" HorizontalAlignment="Right" Width="440" Height="36" Click="BtnOpenPersonnel_Click"/>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="#06060A" CornerRadius="8" Padding="18" BorderBrush="#1F1F2E" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#13131F" CornerRadius="6" Padding="10" Margin="0,0,0,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="ФИЛЬТРАЦИЯ ЗАПИСЕЙ:" Foreground="White" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Margin="5,0,20,0"/>
                            <TextBlock Grid.Column="1" Text="Артист:" Foreground="#858595" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <ComboBox x:Name="cbFilterArtist" Grid.Column="2" Padding="4" SelectionChanged="CbFilter_SelectionChanged"/>
                            <TextBlock Grid.Column="4" Text="Режиссер:" Foreground="#858595" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <ComboBox x:Name="cbFilterEngineer" Grid.Column="5" Padding="4" SelectionChanged="CbFilter_SelectionChanged"/>
                            <Button Content="СБРОС ФИЛЬТРОВ" Grid.Column="6" HorizontalAlignment="Right" Style="{StaticResource NeonButton}" Padding="15,4" Click="BtnResetFilters_Click"/>
                        </Grid>
                    </Border>

                    <ListBox x:Name="lbFiles" Grid.Row="1" Background="Transparent" Foreground="#E0E0E5" BorderThickness="0" FontSize="14" SelectionChanged="LbFiles_SelectionChanged">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="▶ Воспроизвести трек (Превью)" Click="MenuPlayArchive_Click"/>
                                <MenuItem Header="■ Остановить превью" Click="MenuStopArchive_Click"/>
                                <Separator/>
                                <MenuItem Header="❌ Удалить файл из Архива" Click="MenuDeleteArchive_Click"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>

                    <Grid Grid.Row="2" Margin="0,15,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="ИМПОРТИРОВАТЬ ФАЙЛ С ПК" Grid.Column="0" Style="{StaticResource NeonButton}" Click="BtnImport_Click"/>
                        <TextBlock x:Name="lblSavePath" Grid.Column="1" Text="Папка:" Foreground="#333345" FontSize="10" VerticalAlignment="Center" Margin="15,0" TextWrapping="Wrap"/>
                        
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button x:Name="btnExport" Content="ЭКСПОРТ (СОХРАНИТЬ КАК)" Style="{StaticResource NeonButton}" Margin="0,0,8,0" Click="BtnExport_Click"/>
                            <Button x:Name="btnLoadToStudio" Content="⚡ ВЫГРУЗИТЬ НА ПУЛЬТ СТУДИИ" Style="{StaticResource PurpleButton}" Background="#5A189A" Click="BtnLoadToStudio_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>