<Window x:Class="Курсовая_ооп.ArrangerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NEXUS MULTI-TRACK PLAYLIST WORKSPACE" Height="720" Width="1150"
        Background="#08080C" WindowStartupLocation="CenterOwner" FontFamily="Segoe UI">
    
    <Window.Resources>
        <Style TargetType="Button" x:Key="DawButton">
            <Setter Property="Background" Value="#12121A"/>
            <Setter Property="Foreground" Value="#D0D0D5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#222232"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="10,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1A1A2F"/>
                    <Setter Property="BorderBrush" Value="#00FFAA"/>
                    <Setter Property="Foreground" Value="#00FFAA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="SmallStepButton" BasedOn="{StaticResource DawButton}">
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="20"/>
        </Style>

        <Style TargetType="Button" x:Key="MasterTransportButton" BasedOn="{StaticResource DawButton}">
            <Setter Property="Background" Value="#14221F"/>
            <Setter Property="BorderBrush" Value="#00AA77"/>
            <Setter Property="Foreground" Value="#00FFAA"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1A332D"/>
                    <Setter Property="BorderBrush" Value="#00FFBB"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <RowDefinition Height="*"/>    <RowDefinition Height="Auto"/> </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0F0F18" CornerRadius="6" Padding="12,6" Margin="0,0,0,10" BorderBrush="#1C1C2A" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="✦ TIMELINE TRACKER" Foreground="#555566" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                
                <UniformGrid Grid.Column="1" Rows="1" Opacity="0.7">
                    <TextBlock Text="0:00" Foreground="#444455" FontSize="10" HorizontalAlignment="Left"/>
                    <TextBlock Text="0:10" Foreground="#444455" FontSize="10" HorizontalAlignment="Left"/>
                    <TextBlock Text="0:20" Foreground="#444455" FontSize="10" HorizontalAlignment="Left"/>
                    <TextBlock Text="0:30" Foreground="#444455" FontSize="10" HorizontalAlignment="Left"/>
                    <TextBlock Text="0:40" Foreground="#444455" FontSize="10" HorizontalAlignment="Left"/>
                    <TextBlock Text="0:50" Foreground="#444455" FontSize="10" HorizontalAlignment="Left"/>
                    <TextBlock Text="1:00" Foreground="#444455" FontSize="10" HorizontalAlignment="Left"/>
                </UniformGrid>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#111119" CornerRadius="6" BorderBrush="#1E1E2C" BorderThickness="1" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="TRACK 1: VOCAL" Foreground="#FF4A7A" FontWeight="Black" FontSize="11" Margin="0,0,0,6"/>
                        <Button x:Name="btnLoadT1" Content="📁 ОБЗОР ПК" Style="{StaticResource DawButton}" Margin="0,0,0,4" FontSize="11" Click="BtnLoadT1_Click"/>
                        <Button x:Name="btnPasteVocal" Content="🎤 ВСТАВИТЬ ВОКАЛ" Style="{StaticResource DawButton}" Background="#24121A" BorderBrush="#501A28" Foreground="#FF4A7A" FontSize="10" Click="BtnPasteVocal_Click"/>
                    </StackPanel>

                    <Grid Grid.Column="1" Background="#0A0A0F">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <UniformGrid Grid.Row="0" Rows="1" Columns="20" Margin="10,5" Opacity="0.15" IsHitTestVisible="False">
                            <Border Background="#FF4A7A" Height="15" CornerRadius="2" VerticalAlignment="Center" Margin="2"/>
                            <Border Background="#FF4A7A" Height="35" CornerRadius="2" VerticalAlignment="Center" Margin="2"/>
                            <Border Background="#FF4A7A" Height="45" CornerRadius="2" VerticalAlignment="Center" Margin="2"/>
                            <Border Background="#FF4A7A" Height="20" CornerRadius="2" VerticalAlignment="Center" Margin="2"/>
                            <Border Background="#FF4A7A" Height="55" CornerRadius="2" VerticalAlignment="Center" Margin="2"/>
                            <Border Background="#FF4A7A" Height="30" CornerRadius="2" VerticalAlignment="Center" Margin="2"/>
                        </UniformGrid>

                        <Grid Grid.Row="0" VerticalAlignment="Stretch">
                            <Slider x:Name="slT1Play" Minimum="0" Maximum="100" Value="0" VerticalAlignment="Center" Focusable="False"/>
                            <TextBlock x:Name="lblT1Time" Text="00:00" Foreground="#FF4A7A" FontSize="10" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5,2,0,0" IsHitTestVisible="False"/>
                            <TextBlock x:Name="lblT1Name" Text="Вокальная шина пуста" Foreground="#444455" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,5,0" IsHitTestVisible="False"/>
                        </Grid>

                        <DockPanel Grid.Row="1" Margin="0,2,0,0">
                            <TextBlock Text="✂ НАЧАЛО СРЕЗА:" Width="110" Foreground="#666677" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" Margin="5,0"/>
                            <Button Content="-1s" Style="{StaticResource SmallStepButton}" Click="BtnT1TrimStartMinus_Click"/>
                            <Button Content="+1s" Style="{StaticResource SmallStepButton}" Click="BtnT1TrimStartPlus_Click" Margin="2,0,8,0"/>
                            <TextBlock x:Name="lblT1TrimStartVal" Text="0.0 с" Width="50" Foreground="#FF4A7A" FontWeight="Bold" FontSize="10" VerticalAlignment="Center"/>
                            <Slider x:Name="slT1TrimStart" Minimum="0" Maximum="100" Value="0" ValueChanged="SlT1_ValueChanged"/>
                        </DockPanel>

                        <DockPanel Grid.Row="2" Margin="0,2,0,0">
                            <TextBlock Text="✂ КОНЕЦ СРЕЗА:" Width="110" Foreground="#666677" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" Margin="5,0"/>
                            <Button Content="-1s" Style="{StaticResource SmallStepButton}" Click="BtnT1TrimEndMinus_Click"/>
                            <Button Content="+1s" Style="{StaticResource SmallStepButton}" Click="BtnT1TrimEndPlus_Click" Margin="2,0,8,0"/>
                            <TextBlock x:Name="lblT1TrimEndVal" Text="MAX" Width="50" Foreground="#FF4A7A" FontWeight="Bold" FontSize="10" VerticalAlignment="Center"/>
                            <Slider x:Name="slT1TrimEnd" Minimum="0" Maximum="100" Value="100" ValueChanged="SlT1_ValueChanged"/>
                        </DockPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="2" Background="#111119" CornerRadius="6" BorderBrush="#1E1E2C" BorderThickness="1" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="TRACK 2: MUSIC / BEAT" Foreground="#3A86FF" FontWeight="Black" FontSize="11" Margin="0,0,0,6"/>
                        <Button x:Name="btnLoadT2" Content="📁 ОБЗОР ПК" Style="{StaticResource DawButton}" FontSize="11" Click="BtnLoadT2_Click"/>
                    </StackPanel>

                    <Grid Grid.Column="1" Background="#0A0A0F">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <UniformGrid Grid.Row="0" Rows="1" Columns="20" Margin="10,5" Opacity="0.15" IsHitTestVisible="False">
                            <Border Background="#3A86FF" Height="40" CornerRadius="2" VerticalAlignment="Center" Margin="2"/>
                            <Border Background="#3A86FF" Height="45" CornerRadius="2" VerticalAlignment="Center" Margin="2"/>
                            <Border Background="#3A86FF" Height="41" CornerRadius="2" VerticalAlignment="Center" Margin="2"/>
                            <Border Background="#3A86FF" Height="46" CornerRadius="2" VerticalAlignment="Center" Margin="2"/>
                        </UniformGrid>

                        <Grid Grid.Row="0" VerticalAlignment="Stretch">
                            <Slider x:Name="slT2Play" Minimum="0" Maximum="100" Value="0" VerticalAlignment="Center" Focusable="False"/>
                            <TextBlock x:Name="lblT2Time" Text="00:00" Foreground="#3A86FF" FontSize="10" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5,2,0,0" IsHitTestVisible="False"/>
                            <TextBlock x:Name="lblT2Name" Text="Минусовка не выбрана" Foreground="#444455" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,5,0" IsHitTestVisible="False"/>
                        </Grid>

                        <DockPanel Grid.Row="1" Margin="0,2,0,0">
                            <TextBlock Text="✂ НАЧАЛО СРЕЗА:" Width="110" Foreground="#666677" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" Margin="5,0"/>
                            <Button Content="-1s" Style="{StaticResource SmallStepButton}" Click="BtnT2TrimStartMinus_Click"/>
                            <Button Content="+1s" Style="{StaticResource SmallStepButton}" Click="BtnT2TrimStartPlus_Click" Margin="2,0,8,0"/>
                            <TextBlock x:Name="lblT2TrimStartVal" Text="0.0 с" Width="50" Foreground="#3A86FF" FontWeight="Bold" FontSize="10" VerticalAlignment="Center"/>
                            <Slider x:Name="slT2TrimStart" Minimum="0" Maximum="100" Value="0" ValueChanged="SlT2_ValueChanged"/>
                        </DockPanel>

                        <DockPanel Grid.Row="2" Margin="0,2,0,0">
                            <TextBlock Text="✂ КОНЕЦ СРЕЗА:" Width="110" Foreground="#666677" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" Margin="5,0"/>
                            <Button Content="-1s" Style="{StaticResource SmallStepButton}" Click="BtnT2TrimEndMinus_Click"/>
                            <Button Content="+1s" Style="{StaticResource SmallStepButton}" Click="BtnT2TrimEndPlus_Click" Margin="2,0,8,0"/>
                            <TextBlock x:Name="lblT2TrimEndVal" Text="MAX" Width="50" Foreground="#3A86FF" FontWeight="Bold" FontSize="10" VerticalAlignment="Center"/>
                            <Slider x:Name="slT2TrimEnd" Minimum="0" Maximum="100" Value="100" ValueChanged="SlT2_ValueChanged"/>
                        </DockPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="4" Background="#111119" CornerRadius="6" BorderBrush="#1E1E2C" BorderThickness="1" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="TRACK 3: FX / LOOP" Foreground="#9D4EDD" FontWeight="Black" FontSize="11" Margin="0,0,0,6"/>
                        <Button x:Name="btnLoadT3" Content="📁 ОБЗОР ПК" Style="{StaticResource DawButton}" FontSize="11" Click="BtnLoadT3_Click"/>
                    </StackPanel>

                    <Grid Grid.Column="1" Background="#0A0A0F">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <UniformGrid Grid.Row="0" Rows="1" Columns="20" Margin="10,5" Opacity="0.15" IsHitTestVisible="False">
                            <Border Background="#9D4EDD" Height="15" CornerRadius="2" VerticalAlignment="Center" Margin="2"/>
                            <Border Background="#9D4EDD" Height="25" CornerRadius="2" VerticalAlignment="Center" Margin="2"/>
                        </UniformGrid>

                        <Grid Grid.Row="0" VerticalAlignment="Stretch">
                            <Slider x:Name="slT3Play" Minimum="0" Maximum="100" Value="0" VerticalAlignment="Center" Focusable="False"/>
                            <TextBlock x:Name="lblT3Time" Text="00:00" Foreground="#9D4EDD" FontSize="10" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5,2,0,0" IsHitTestVisible="False"/>
                            <TextBlock x:Name="lblT3Name" Text="Эффекты не выбраны" Foreground="#444455" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,5,0" IsHitTestVisible="False"/>
                        </Grid>

                        <DockPanel Grid.Row="1" Margin="0,2,0,0">
                            <TextBlock Text="✂ НАЧАЛО СРЕЗА:" Width="110" Foreground="#666677" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" Margin="5,0"/>
                            <Button Content="-1s" Style="{StaticResource SmallStepButton}" Click="BtnT3TrimStartMinus_Click"/>
                            <Button Content="+1s" Style="{StaticResource SmallStepButton}" Click="BtnT3TrimStartPlus_Click" Margin="2,0,8,0"/>
                            <TextBlock x:Name="lblT3TrimStartVal" Text="0.0 с" Width="50" Foreground="#9D4EDD" FontWeight="Bold" FontSize="10" VerticalAlignment="Center"/>
                            <Slider x:Name="slT3TrimStart" Minimum="0" Maximum="100" Value="0" ValueChanged="SlT3_ValueChanged"/>
                        </DockPanel>

                        <DockPanel Grid.Row="2" Margin="0,2,0,0">
                            <TextBlock Text="✂ КОНЕЦ СРЕЗА:" Width="110" Foreground="#666677" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" Margin="5,0"/>
                            <Button Content="-1s" Style="{StaticResource SmallStepButton}" Click="BtnT3TrimEndMinus_Click"/>
                            <Button Content="+1s" Style="{StaticResource SmallStepButton}" Click="BtnT3TrimEndPlus_Click" Margin="2,0,8,0"/>
                            <TextBlock x:Name="lblT3TrimEndVal" Text="MAX" Width="50" Foreground="#9D4EDD" FontWeight="Bold" FontSize="10" VerticalAlignment="Center"/>
                            <Slider x:Name="slT3TrimEnd" Minimum="0" Maximum="100" Value="100" ValueChanged="SlT3_ValueChanged"/>
                        </DockPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#0F0F18" CornerRadius="6" Padding="15" BorderBrush="#1C1C2A" BorderThickness="1" Margin="0,15,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="btnPlayMix" Content="▶ ВОСПРОИЗВЕСТИ СОВМЕСТНЫЙ МИКС" Style="{StaticResource MasterTransportButton}" Width="280" Height="38" Click="BtnPlayMix_Click"/>
                    <Button x:Name="btnStopMix" Content="■ СТОП" Style="{StaticResource DawButton}" Width="70" Height="38" Margin="5,0,25,0" Click="BtnStopMix_Click"/>
                    
                    <Button x:Name="btnBounce" Content="⚡ СВЕСТИ И СОХРАНИТЬ В АРХИВ (BOUNCE)" Style="{StaticResource DawButton}" Background="#2A143A" BorderBrush="#6A1B9A" Foreground="#E0AAFF" Width="300" Height="38" Click="BtnBounce_Click"/>
                    <TextBlock x:Name="lblRenderProgress" Text="Статус: Ожидание дорожек..." Foreground="#555566" FontSize="11" VerticalAlignment="Center" Margin="15,0,0,0"/>
                </StackPanel>
                <Button Content="ЗАКРЫТЬ ПУЛЬТ" Style="{StaticResource DawButton}" HorizontalAlignment="Right" Width="140" Height="38" Click="BtnClose_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>